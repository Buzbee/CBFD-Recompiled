+            viRenderer->render(renderParams);
+            return true;
+        }
+
+        commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(stereoUIScratchTexture.get(), RenderTextureLayout::SHADER_READ));
