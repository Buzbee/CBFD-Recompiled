+    bool RigidBody::updateCameraCut(const hlslpp::float4x4 &prevView, const hlslpp::float4x4 &curView) {
+        // The camera itself (a view matrix's inverse): where it is (row 3) and which way it looks (row 2).
+        const hlslpp::float4x4 prevCamera = hlslpp::inverse(prevView);
+        const hlslpp::float4x4 curCamera = hlslpp::inverse(curView);
+        const float move = hlslpp::length(curCamera[3].xyz - prevCamera[3].xyz);
+        const hlslpp::float3 prevForward = prevCamera[2].xyz;
+        const hlslpp::float3 curForward = curCamera[2].xyz;
+        const float lengths = hlslpp::length(prevForward) * hlslpp::length(curForward);
+        const float cosTurn = (lengths > 1e-6f) ? float(hlslpp::dot(prevForward, curForward)) / lengths : 1.0f;
+        const float turn = std::acos(std::clamp(cosTurn, -1.0f, 1.0f));
+
+        // A cut is a jump well beyond both a camera's usual pace and the one it just had: moving further than MinCutMove
+        // (world units) or turning more than MinCutTurn in one game frame, and CutJump times as far as the frame before.
+        // A camera that speeds up keeps interpolating; one that jumps to another shot, whose in-between frames would show
+        // it partway along the jump (inside the scenery, looking between the two shots), doesn't.
+        const float MinCutMove = 150.0f; // TODO: Make configurable.
+        const float MinCutTurn = 50.0f * 3.14159265f / 180.0f;
+        const float CutJump = 4.0f;
+        const bool cut = ((move > MinCutMove) && (move > cameraMove * CutJump)) || ((turn > MinCutTurn) && (turn > cameraTurn * CutJump));
+        cameraMove = move;
+        cameraTurn = turn;
+        return cut;
+    }
+
