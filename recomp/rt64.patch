+        blitParams.textureWidth = width;
+        blitParams.textureHeight = height;
+        blitParams.blitTexture = true;
+        // The blit's halves are half the window each, so a half-window scratch lands unscaled.
+        blitParams.fillFullTarget = false;
+        viRenderer->render(blitParams);
+        return true;
