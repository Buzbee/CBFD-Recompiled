diff --git a/src/render/rt64_stereo_auto_convergence.cpp b/src/render/rt64_stereo_auto_convergence.cpp
new file mode 100644
index 0000000..e0e6eb0
--- /dev/null
+++ b/src/render/rt64_stereo_auto_convergence.cpp
@@ -0,0 +1,98 @@
+//
+// RT64
+//
+
+#include "rt64_stereo_auto_convergence.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace RT64 {
+    void StereoAutoConvergence::setSettings(bool enabledValue, float manualConvergenceValue) {
+        enabled = enabledValue;
+        manualConvergence = std::max(manualConvergenceValue, NearClamp);
+
+        // Turning it off forgets the scene; turning it on fits the next frame.
+        if (!enabled) {
+            initialized = false;
+            snapPending = false;
+            sceneNear = 0.0f;
+            sceneMedian = 0.0f;
+        }
+        else if (!initialized) {
+            initialized = true;
+            snapPending = true;
+        }
+    }
+
+    void StereoAutoConvergence::requestSnap() {
+        if (enabled) {
+            snapPending = true;
+        }
+    }
+
+    void StereoAutoConvergence::snap(float zNear, float zMedian) {
+        if (!enabled || !std::isfinite(zNear) || (zNear <= 1.0f)) {
+            return;
+        }
+
+        sceneNear = zNear;
+        sceneMedian = (std::isfinite(zMedian) && (zMedian >= zNear)) ? zMedian : zNear;
+        snapPending = false;
+    }
+
+    float StereoAutoConvergence::applied() const {
+        if (!enabled || (sceneNear <= 0.0f)) {
+            return manualConvergence;
+        }
+
+        // The nearest object's total disparity at convergence c, in units of the
+        // separation, is c/near - 1 (each eye shifts by separation * (1 - c/z) in NDC, so
+        // the pair spans that fraction of the width): the budget caps c at
+        // near * (1 + budget). It doesn't depend on the separation, and the slider, the
+        // ceiling, applies at once without waiting for a scene.
+        const float fitted = sceneNear * (1.0f + TargetDisparityFraction);
+        return std::clamp(fitted, NearClamp, manualConvergence);
+    }
+
+    float StereoAutoConvergence::focusDepth() const {
+        return enabled ? sceneNear : 0.0f;
+    }
+
+    bool StereoAutoConvergence::isCameraCut(const hlslpp::float4x4 &prevView, const hlslpp::float4x4 &prevProj,
+        const hlslpp::float4x4 &curView, const hlslpp::float4x4 &curProj, float sceneMedian,
+        float &moveOut, float &rotationDegreesOut, float &fovRatioOut)
+    {
+        // Row-vector convention (clip = pos * view * proj): the camera's own transform is
+        // the view's inverse, its position the inverse's translation row.
+        const hlslpp::float4x4 prevCamera = hlslpp::inverse(prevView);
+        const hlslpp::float4x4 curCamera = hlslpp::inverse(curView);
+        const hlslpp::float3 prevPosition = prevCamera[3].xyz;
+        const hlslpp::float3 curPosition = curCamera[3].xyz;
+        moveOut = float(hlslpp::length(curPosition - prevPosition));
+
+        // The camera's axes in the world are the camera transform's rows; the largest
+        // angle between the matching axes of the two frames is the turn (normalized: the
+        // game's view matrices can carry a scale).
+        float minCos = 1.0f;
+        for (int axis = 0; axis < 3; axis++) {
+            const hlslpp::float3 a = prevCamera[axis].xyz;
+            const hlslpp::float3 b = curCamera[axis].xyz;
+            const float lengths = float(hlslpp::length(a)) * float(hlslpp::length(b));
+            if (lengths > 1e-12f) {
+                minCos = std::min(minCos, float(hlslpp::dot(a, b)) / lengths);
+            }
+        }
+
+        rotationDegreesOut = std::acos(std::clamp(minCos, -1.0f, 1.0f)) * (180.0f / 3.14159265f);
+
+        // The vertical field of view's scale (P11 = 1/tan(half FoV)), which RT64's
+        // widescreen adjustment leaves alone.
+        const float prevScale = std::fabs(float(prevProj[1][1]));
+        const float curScale = std::fabs(float(curProj[1][1]));
+        fovRatioOut = ((prevScale > 1e-8f) && (curScale > 1e-8f)) ? (std::max(prevScale, curScale) / std::min(prevScale, curScale)) : 1.0f;
+
+        const bool moved = (sceneMedian > 0.0f) && (moveOut > sceneMedian * CutTranslationFraction);
+        return moved || (rotationDegreesOut > CutRotationDegrees) || (fovRatioOut > CutFovRatio);
+    }
+}
diff --git a/src/render/rt64_stereo_auto_convergence.h b/src/render/rt64_stereo_auto_convergence.h
new file mode 100644
index 0000000..3f27bba
--- /dev/null
+++ b/src/render/rt64_stereo_auto_convergence.h
@@ -0,0 +1,63 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <cstdint>
+
+#include "common/rt64_math.h"
+
+namespace RT64 {
+    // Conker: auto-convergence, per scene. The convergence is fixed for the whole of a
+    // scene and snaps, on the scene's first frame, to fit that scene: within a scene the
+    // depth never changes, at all. A scene begins when the world camera cuts (it jumps in
+    // position, rotation or field of view between two game frames, see isCameraCut) or
+    // reappears after frames without it (loading, FMV, the first frame).
+    //
+    // The fit: the scene's nearest significant depth (a robust percentile of its depth
+    // buffer, in view-space units) gets a pop-out within a budget. The manual convergence
+    // stays the ceiling: auto only ever pulls closer, never past it.
+    struct StereoAutoConvergence {
+        // The comfort budget for the nearest object's total on-screen disparity, as a
+        // fraction of the separation (separation itself is the screen-width fraction
+        // spanned by the background, so 0.4 keeps the nearest object's pop-out at 40%
+        // of the background disparity).
+        static constexpr float TargetDisparityFraction = 0.4f;
+        static constexpr float NearClamp = 2.0f;
+        // A camera cut, between two consecutive game frames (33 ms): a turn no camera
+        // makes in that time, a move of a large part of the distance to the scene, or a
+        // jump in the field of view. A following camera stays well under all three.
+        static constexpr float CutRotationDegrees = 30.0f;
+        static constexpr float CutTranslationFraction = 0.5f; // of the scene's median depth
+        static constexpr float CutFovRatio = 1.2f;
+
+        bool enabled = false;
+        float manualConvergence = 200.0f;
+        bool initialized = false;
+        // Wants the next frame's depth to fit a new scene to.
+        bool snapPending = false;
+        // The current scene's nearest and median depths (0 while it has none yet).
+        float sceneNear = 0.0f;
+        float sceneMedian = 0.0f;
+
+        void setSettings(bool enabled, float manualConvergence);
+        // A scene begins with the frame being rendered: fit the convergence to its depth.
+        void requestSnap();
+        bool wantsDepth() const { return enabled && snapPending; }
+        // Fits the scene to a frame's depth, if it has any (zNear <= 0: none, the snap
+        // stays pending).
+        void snap(float zNear, float zMedian);
+        float applied() const;
+        // The scene's focus distance (its nearest depth, world units; 0 when the loop is
+        // off or has not fitted a scene yet).
+        float focusDepth() const;
+
+        // Whether the world camera cut between two game frames' view and projection
+        // matrices. sceneMedian scales the translation test (0: unknown, translation is
+        // not tested).
+        static bool isCameraCut(const hlslpp::float4x4 &prevView, const hlslpp::float4x4 &prevProj,
+            const hlslpp::float4x4 &curView, const hlslpp::float4x4 &curProj, float sceneMedian,
+            float &moveOut, float &rotationDegreesOut, float &fovRatioOut);
+    };
+}
