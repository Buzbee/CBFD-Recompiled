+        // is the whole scratch.
+        VIRenderer::RenderParams monoParams = renderParams;
+        monoParams.textureRight = nullptr;
+        monoParams.stereoMode = 0;
+        viRenderer->render(monoParams);
+
+        commandList->setViewports(RenderViewport(0.0f, 0.0f, float(width), float(height)));
+        commandList->setScissors(RenderRect(0, 0, int32_t(width), int32_t(height)));
