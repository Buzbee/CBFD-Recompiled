diff --git a/src/common/rt64_perflog.h b/src/common/rt64_perflog.h
new file mode 100644
index 0000000..c0800aa
--- /dev/null
+++ b/src/common/rt64_perflog.h
@@ -0,0 +1,189 @@
+//
+// RT64
+//
+
+// TEMP-DEBUG (Conker): stereo performance log. Off unless CONKER_PERF_LOG is set. Every
+// two seconds it prints to stderr how many frames were presented, and per rendered target
+// (one per eye in stereo) the renderer thread's time, the part of it spent waiting for the
+// GPU, and the GPU's own time; and the longest gap between two presents, with how many
+// gaps were long enough to show a frame twice at 60 Hz.
+
+#pragma once
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+
+namespace RT64 {
+    namespace PerfLog {
+        // Named waits whose worst case per window is printed (the [perfwait] line).
+        enum Span {
+            PresentWaitFrame,
+            PresentAcquire,
+            PresentGpu,
+            PresentPace,
+            PresentCall,
+            RenderWaitPresented,
+            RenderWaitTarget,
+            WorkloadIdle,
+            SpanCount
+        };
+
+        inline const char *spanName(int span) {
+            static const char *names[SpanCount] = { "present:frame", "present:acquire", "present:gpu", "present:pace", "present:call", "render:presented", "render:target", "workload:idle" };
+            return names[span];
+        }
+
+        struct State {
+            std::mutex mutex;
+            std::chrono::steady_clock::time_point windowStart = std::chrono::steady_clock::now();
+            unsigned presents = 0;
+            unsigned targets = 0;
+            double renderMs = 0.0;
+            double waitMs = 0.0;
+            double gpuMs = 0.0;
+            double presentCpuMs = 0.0;
+            std::chrono::steady_clock::time_point lastPresent;
+            double maxIntervalMs = 0.0;
+            unsigned longIntervals = 0;
+            double spanMax[SpanCount] = {};
+            double spanSum[SpanCount] = {};
+            // Per game frame (workload): whether it could be interpolated, and what happened to
+            // the display frames it planned.
+            unsigned workloads = 0;
+            unsigned noInterpolationTarget = 0;
+            unsigned notInterpolated = 0;
+            unsigned framesPlanned = 0;
+            unsigned framesRendered = 0;
+            unsigned framesSkippedForTime = 0;
+            unsigned framesDroppedForNewer = 0;
+            // In-between display frames where the world camera moved since the last game frame,
+            // and how many of those interpolated it.
+            unsigned cameraMoved = 0;
+            unsigned cameraInterpolated = 0;
+        };
+
+        inline bool enabled() {
+            static const bool on = (std::getenv("CONKER_PERF_LOG") != nullptr);
+            return on;
+        }
+
+        inline State &state() {
+            static State s;
+            return s;
+        }
+
+        inline void addTarget(double renderMs, double waitMs, double gpuMs) {
+            if (!enabled()) {
+                return;
+            }
+
+            State &s = state();
+            std::scoped_lock<std::mutex> lock(s.mutex);
+            s.targets++;
+            s.renderMs += renderMs;
+            s.waitMs += waitMs;
+            s.gpuMs += gpuMs;
+        }
+
+        inline void addSpan(Span span, double ms) {
+            if (!enabled()) {
+                return;
+            }
+
+            State &s = state();
+            std::scoped_lock<std::mutex> lock(s.mutex);
+            s.spanMax[span] = (ms > s.spanMax[span]) ? ms : s.spanMax[span];
+            s.spanSum[span] += ms;
+        }
+
+        // One game frame: noTarget when RT64 found no frame it drew to interpolate, interpolated
+        // when it generated in-between frames, and how many of the planned display frames were
+        // rendered, skipped for lack of time, or dropped because a newer game frame was waiting.
+        inline void addWorkload(bool noTarget, bool interpolated, unsigned planned, unsigned rendered, unsigned skippedForTime, unsigned droppedForNewer) {
+            if (!enabled()) {
+                return;
+            }
+
+            State &s = state();
+            std::scoped_lock<std::mutex> lock(s.mutex);
+            s.workloads++;
+            s.noInterpolationTarget += noTarget ? 1 : 0;
+            s.notInterpolated += interpolated ? 0 : 1;
+            s.framesPlanned += planned;
+            s.framesRendered += rendered;
+            s.framesSkippedForTime += skippedForTime;
+            s.framesDroppedForNewer += droppedForNewer;
+        }
+
+        // An in-between display frame of the world camera that moved since the last game frame:
+        // interpolated when RT64 interpolated it rather than showing the game frame's camera.
+        inline void addCameraMove(bool interpolated) {
+            if (!enabled()) {
+                return;
+            }
+
+            State &s = state();
+            std::scoped_lock<std::mutex> lock(s.mutex);
+            s.cameraMoved++;
+            s.cameraInterpolated += interpolated ? 1 : 0;
+        }
+
+        inline void addPresent(double presentCpuMs) {
+            if (!enabled()) {
+                return;
+            }
+
+            State &s = state();
+            std::scoped_lock<std::mutex> lock(s.mutex);
+            s.presents++;
+            s.presentCpuMs += presentCpuMs;
+            const auto now = std::chrono::steady_clock::now();
+            if (s.lastPresent != std::chrono::steady_clock::time_point()) {
+                const double intervalMs = std::chrono::duration<double, std::milli>(now - s.lastPresent).count();
+                s.maxIntervalMs = (intervalMs > s.maxIntervalMs) ? intervalMs : s.maxIntervalMs;
+                // Longer than one and a half 60 Hz refreshes: a frame shown twice.
+                s.longIntervals += (intervalMs > 25.0) ? 1 : 0;
+            }
+
+            s.lastPresent = now;
+            const double seconds = std::chrono::duration<double>(now - s.windowStart).count();
+            if (seconds >= 2.0) {
+                const double t = (s.targets > 0) ? double(s.targets) : 1.0;
+                const double p = (s.presents > 0) ? double(s.presents) : 1.0;
+                std::fprintf(stderr, "[perf] fps %.1f targets/s %.1f | per target: render %.2f ms (gpu wait %.2f) gpu %.2f ms | present cpu %.2f ms | max interval %.1f ms, %u long\n",
+                    s.presents / seconds, s.targets / seconds, s.renderMs / t, s.waitMs / t, s.gpuMs / t, s.presentCpuMs / p, s.maxIntervalMs, s.longIntervals);
+                std::fprintf(stderr, "[perfwait] max/sum ms:");
+                for (int i = 0; i < SpanCount; i++) {
+                    std::fprintf(stderr, " %s %.1f/%.0f", spanName(i), s.spanMax[i], s.spanSum[i]);
+                    s.spanMax[i] = 0.0;
+                    s.spanSum[i] = 0.0;
+                }
+
+                std::fprintf(stderr, "\n");
+                std::fprintf(stderr, "[perfinterp] game frames %.1f/s | not interpolated %u (no target %u) | display frames planned %u rendered %u skipped-for-time %u dropped-for-newer %u | camera moving %u interpolated %u\n",
+                    s.workloads / seconds, s.notInterpolated, s.noInterpolationTarget, s.framesPlanned, s.framesRendered, s.framesSkippedForTime, s.framesDroppedForNewer, s.cameraMoved, s.cameraInterpolated);
+                s.cameraMoved = 0;
+                s.cameraInterpolated = 0;
+                s.workloads = 0;
+                s.noInterpolationTarget = 0;
+                s.notInterpolated = 0;
+                s.framesPlanned = 0;
+                s.framesRendered = 0;
+                s.framesSkippedForTime = 0;
+                s.framesDroppedForNewer = 0;
+                std::fflush(stderr);
+                s.windowStart = now;
+                s.presents = 0;
+                s.targets = 0;
+                s.renderMs = 0.0;
+                s.waitMs = 0.0;
+                s.gpuMs = 0.0;
+                s.presentCpuMs = 0.0;
+                s.maxIntervalMs = 0.0;
+                s.longIntervals = 0;
+            }
+        }
+    };
+};
